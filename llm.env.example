# Copy this file to llm.env and keep llm.env out of git.
# Any provider with an OpenAI-compatible /v1/embeddings endpoint can be used.

SPRINGGRAPH_EMBEDDING_PROVIDER=openai_compatible
SPRINGGRAPH_EMBEDDING_MODEL=text-embedding-3-small
SPRINGGRAPH_EMBEDDING_DIM=1024
SPRINGGRAPH_EMBEDDING_BASE_URL=https://api.openai.com/v1
SPRINGGRAPH_EMBEDDING_API_KEY=replace-with-your-api-key
SPRINGGRAPH_EMBEDDING_TIMEOUT_SECONDS=60

SPRINGGRAPH_LLM_PROVIDER=openai_compatible
SPRINGGRAPH_LLM_MODEL=gpt-4o-mini
SPRINGGRAPH_LLM_BASE_URL=https://api.openai.com/v1
SPRINGGRAPH_LLM_API_KEY=replace-with-your-api-key
SPRINGGRAPH_LLM_TIMEOUT_SECONDS=60
SPRINGGRAPH_LLM_TEMPERATURE=0

# Optional planner-specific chat model.
# If omitted, all SPRINGGRAPH_PLANNER_LLM_* values fall back to SPRINGGRAPH_LLM_*.
# SPRINGGRAPH_PLANNER_LLM_PROVIDER=openai_compatible
# SPRINGGRAPH_PLANNER_LLM_MODEL=gpt-4o-mini
# SPRINGGRAPH_PLANNER_LLM_BASE_URL=https://api.openai.com/v1
# SPRINGGRAPH_PLANNER_LLM_API_KEY=replace-with-your-api-key
# SPRINGGRAPH_PLANNER_LLM_TIMEOUT_SECONDS=30
# SPRINGGRAPH_PLANNER_LLM_TEMPERATURE=0
